{
    "name": "@idle-runner/react",
    "version": "1.2.1",
    "description": "React hooks (useIdleTask, useIdleValue, useIdleCallback, useIdleEffect) to defer and time-slice non-urgent work off the main thread with requestIdleCallback — works on Safari, where it never shipped.",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/PavelLazarchuk/idle-runner-react.git"
    },
    "bugs": "https://github.com/PavelLazarchuk/idle-runner-react/issues",
    "homepage": "https://github.com/PavelLazarchuk/idle-runner-react#readme",
    "keywords": [
        "@idle-runner/react",
        "idle-runner",
        "react",
        "react-hooks",
        "hooks",
        "idle",
        "requestIdleCallback",
        "scheduler",
        "INP",
        "core-web-vitals",
        "main-thread",
        "task-queue",
        "performance",
        "safari",
        "nextjs",
        "typescript"
    ],
    "author": "Pavel Lazarchuk",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --project unit --project ssr",
        "test:watch": "vitest --project unit",
        "test:browser": "vitest run --project browser",
        "check-exports": "publint && attw --pack .",
        "size": "size-limit",
        "changeset": "changeset",
        "release": "npm run build && node scripts/publish-if-new.mjs",
        "prepare": "husky"
    },
    "dependencies": {
        "@idle-runner/core": "^1.3.0"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@changesets/cli": "^2.31.1",
        "@size-limit/preset-small-lib": "^13.0.3",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.1",
        "@vitest/browser": "^4.1.10",
        "@vitest/browser-playwright": "^4.1.10",
        "eslint": "^10.7.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "husky": "^9.1.7",
        "jsdom": "^28.1.0",
        "lint-staged": "^17.0.8",
        "playwright": "^1.61.1",
        "prettier": "^3.9.5",
        "publint": "^0.3.21",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "size-limit": "^13.0.3",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.64.0",
        "vitest": "^4.1.10"
    }
}
